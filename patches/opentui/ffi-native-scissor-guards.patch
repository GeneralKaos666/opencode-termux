# ffi-native-scissor-guards (task-tui-common-fix, v2 B-line) — packages/native layout.
#
# The v2 OpenTUI tree moved the Zig sources to packages/native, so the core-tree
# exemplar guard patch (fix-drawchar-negative-coords.patch, packages/core/src/zig)
# no longer reaches the compiled library. This patch mirrors the exemplar guard
# semantics onto packages/native/src/{buffer,renderer}.zig:
#   - isPointInScissor / isRectInScissor / clipRectToScissor scissor-size clamps
#     (@min(w/h, 0x7FFFFFFF)) + saturating adds (buffer.zig)
#   - setCellWithAlphaBlendingCellWithoutImages / setVisibleCellWithAlphaBlending /
#     setCellWithAlphaBlendingRawCell bit31 coordinate early-returns (buffer.zig)
#   - drawTextBufferInternal INT32_MIN negation early-return (buffer.zig)
#   - drawGrayscaleBuffer{,Supersampled} INT32_MIN negation early-returns (buffer.zig)
#   - renderer hit-grid scissor clamps + saturating end coords (renderer.zig)
# Guard presence is enforced semantically by build-libopentui.sh regardless of
# patch drift.
diff --git a/packages/native/src/buffer.zig b/packages/native/src/buffer.zig
index e3de5a3..9ac93c7 100644
--- a/packages/native/src/buffer.zig
+++ b/packages/native/src/buffer.zig
@@ -319,17 +319,30 @@ pub const OptimizedBuffer = struct {
 
     pub fn isPointInScissor(self: *const OptimizedBuffer, x: i32, y: i32) bool {
         const scissor = self.getCurrentScissorRect() orelse return true;
-        return x >= scissor.x and x < scissor.x + @as(i32, @intCast(scissor.width)) and
-            y >= scissor.y and y < scissor.y + @as(i32, @intCast(scissor.height));
+        // FFI negative-coordinate defense (task-tui-common-fix): JS may pass
+        // negative-derived scissor sizes that cross FFI as huge u32 values;
+        // clamp instead of @intCast (panic) so clipping degrades gracefully.
+        const w = @as(i32, @intCast(@min(scissor.width, 0x7FFFFFFF)));
+        const h = @as(i32, @intCast(@min(scissor.height, 0x7FFFFFFF)));
+        return x >= scissor.x and x < scissor.x +| w and
+            y >= scissor.y and y < scissor.y +| h;
     }
 
     pub fn isRectInScissor(self: *const OptimizedBuffer, x: i32, y: i32, width: u32, height: u32) bool {
         const scissor = self.getCurrentScissorRect() orelse return true;
 
-        const rect_end_x = x + @as(i32, @intCast(width));
-        const rect_end_y = y + @as(i32, @intCast(height));
-        const scissor_end_x = scissor.x + @as(i32, @intCast(scissor.width));
-        const scissor_end_y = scissor.y + @as(i32, @intCast(scissor.height));
+        // FFI negative-coordinate defense (task-tui-common-fix): clamp u32
+        // values that cross FFI as huge u32 (bit31 set) before @intCast, and
+        // use saturating add so end coords never overflow.
+        const w = @as(i32, @intCast(@min(width, 0x7FFFFFFF)));
+        const h = @as(i32, @intCast(@min(height, 0x7FFFFFFF)));
+        const sw = @as(i32, @intCast(@min(scissor.width, 0x7FFFFFFF)));
+        const sh = @as(i32, @intCast(@min(scissor.height, 0x7FFFFFFF)));
+
+        const rect_end_x = x +| w;
+        const rect_end_y = y +| h;
+        const scissor_end_x = scissor.x +| sw;
+        const scissor_end_y = scissor.y +| sh;
 
         return !(x >= scissor_end_x or rect_end_x <= scissor.x or
             y >= scissor_end_y or rect_end_y <= scissor.y);
