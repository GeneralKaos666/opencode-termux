pkgname=opencode1-wrapper
pkgver=1.2.10
pkgrel=1
pkgdesc='OpenCode for Termux from local staged prefix (v1 wrapper appendix; renamed opencode1-wrapper)'
arch=('aarch64')
url='https://github.com/anomalyco/opencode'
license=('MIT')
options=('!strip' '!debug' '!emptydirs')
replaces=('opencode1-glibc')
conflicts=('opencode' 'opencode1-compressed')

makedepends=()
source=()
sha256sums=()

# FIX: use /usr (relative staging) not the full prefix path, so tarball paths
# are usr/bin/opencode — avoids double-prefix on `pacman -U` install.
_repo_root="${REPO_ROOT:-$(cd "$(dirname "$0")/../.." && pwd)}"
_staged_prefix="${STAGED_PREFIX:-${_repo_root}/artifacts/staged/prefix}"

prepare() {
  [[ -x "${_staged_prefix}/lib/opencode/runtime/opencode" ]] || {
    error "missing runtime at ${_staged_prefix}/lib/opencode/runtime/opencode"
    return 1
  }
  [[ -x "${_staged_prefix}/bin/opencode" ]] || {
    error "missing launcher at ${_staged_prefix}/bin/opencode"
    return 1
  }
}

build() {
  true
}

package() {
  mkdir -p "$pkgdir/usr/bin"
  install -D -m755 "${_staged_prefix}/bin/opencode" "$pkgdir/usr/bin/opencode"
}
